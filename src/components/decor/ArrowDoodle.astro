---
interface Props {
  tone?: "blue" | "lime" | "coral" | "ink" | "paper";
  class?: string;
}

const { tone = "coral", class: className = "" } = Astro.props;
---

<svg
  class:list={["arrow", `tone-${tone}`, className]}
  viewBox="0 0 150 96"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M8 14C22 52 60 76 124 50"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
  />
  <path
    d="M124 50 106 39M124 50 108 64"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
  />
</svg>

<style>
  .arrow {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
