---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
      <span>{site.firstName}</span><span class="wordmark__last"> {site.lastName}</span>
      <span class="wordmark__star" aria-hidden="true">*</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a class="site-nav__about" href="/#about">About</a>
      <a href="/#work">Work</a>
      <a href="/#skills">Skills</a>
      <a class="site-nav__contact" href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: var(--border-hair) solid var(--c-rule);
    background-color: var(--c-cream);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--header-h);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark__star {
    display: inline-block;
    margin-left: var(--space-3xs);
    color: var(--c-coral);
    font-size: var(--text-2xs);
    vertical-align: super;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
  }

  .site-nav a {
    padding-block: var(--space-2xs);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--c-blue);
  }

  .site-nav__contact {
    padding: var(--space-2xs) var(--space-sm);
    border: var(--border-hair) solid var(--c-ink);
    border-radius: var(--radius-pill);
  }

  .site-nav a.site-nav__contact:hover {
    background-color: var(--c-ink);
    color: var(--c-cream);
  }

  @media (max-width: 48rem) {
    .site-nav {
      gap: var(--space-sm);
    }
  }

  @media (max-width: 36rem) {
    .wordmark__last {
      display: none;
    }
  }

  @media (max-width: 24rem) {
    .site-nav__about {
      display: none;
    }
  }
</style>
