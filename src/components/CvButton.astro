---
import { site } from "../data/site";

interface Props {
  tone?: "outline" | "lime";
  class?: string;
}

const { tone = "outline", class: className = "" } = Astro.props;
---

<a
  class:list={["button", tone === "lime" && "button--lime", "cv-button", className]}
  href={site.cv.href}
  download={site.cv.fileName}
>
  {site.cv.label}
  <svg class="cv-button__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
    <path
      d="M10 2.5v9m0 0 3.25-3.25M10 11.5 6.75 8.25M3.5 13.5v2A1.5 1.5 0 0 0 5 17h10a1.5 1.5 0 0 0 1.5-1.5v-2"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</a>

<style>
  .cv-button__icon {
    width: 1.05em;
    height: 1.05em;
    flex: none;
  }
</style>
