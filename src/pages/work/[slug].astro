---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import ogHome from "../../assets/og/og-home.png";

export async function getStaticPaths() {
  const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length] ?? project,
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const ogImage = data.ogImage ?? ogHome;
const mailSubject = encodeURIComponent(`Question about “${data.title}”`);
---

<BaseLayout
  title={data.title}
  description={data.summary}
  ogImage={ogImage}
  ogTitle={`${data.title} — ${site.name}`}
  ogType="article"
  bodyClass="case-page"
>
  <article class="case">
    <header class="case__header container">
      <a class="case__back" href="/#work">
        <span aria-hidden="true">←</span> All work
      </a>

      <p class="eyebrow case__context">{data.context} · {data.year}</p>
      <h1 class="case__title">{data.title}</h1>
      <p class="case__summary">{data.summary}</p>
      <p class="case__question">
        <span>Question I started with</span>
        {data.question}
      </p>

      <dl class="case__meta">
        <div>
          <dt>Role</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>Timeline</dt>
          <dd>{data.timeline}</dd>
        </div>
        <div>
          <dt>Team</dt>
          <dd>{data.team}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{data.status}</dd>
        </div>
      </dl>
    </header>

    <figure class="case__cover container">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[800, 1200, 1600]}
        sizes="(min-width: 90rem) 82rem, 100vw"
        loading="eager"
        decoding="async"
      />
      <figcaption>{data.context} — cover illustration</figcaption>
    </figure>

    <div class="case__layout container">
      <aside class="case__aside" aria-label="Case summary">
        <div class="case__outcome">
          <p class="eyebrow">Outcome, as tested</p>
          <p class="case__outcome-text">{data.outcome}</p>
        </div>

        <dl class="case__aside-facts">
          <div>
            <dt>Tools</dt>
            <dd>{data.tools.join(" · ")}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{data.status}</dd>
          </div>
        </dl>

        <a class="button case__contact" href={`mailto:${site.email}?subject=${mailSubject}`}>
          Ask me about this <span aria-hidden="true">→</span>
        </a>
      </aside>

      <div class="prose case__prose">
        <Content />
      </div>
    </div>

    <nav class="case__next container" aria-label="Next case">
      <p class="eyebrow">Next case</p>
      <a class="case__next-link" href={`/work/${next.id}/`}>
        <span class="case__next-title">{next.data.title}</span>
        <span class="case__next-arrow" aria-hidden="true">→</span>
      </a>
      <p class="case__next-meta">{next.data.context} · {next.data.year}</p>
    </nav>
  </article>
</BaseLayout>

<style>
  .case {
    padding-block: var(--space-xl) var(--section-y-sm);
  }

  .case__header {
    max-width: none;
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-2xl);
    color: var(--c-ink-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .case__back:hover {
    color: var(--c-blue);
  }

  .case__context {
    margin-bottom: var(--space-xs);
  }

  .case__title {
    max-width: 16ch;
    font-size: var(--text-case);
    line-height: var(--leading-tight);
  }

  .case__summary {
    max-width: var(--case-deck-width);
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  .case__question {
    display: grid;
    max-width: var(--measure-wide);
    gap: var(--space-3xs);
    margin-top: var(--space-lg);
    padding-left: var(--space-md);
    border-left: var(--border-thick) solid var(--c-blue);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .case__question span {
    color: var(--c-ink-muted);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-style: normal;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .case__meta {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.4fr;
    gap: var(--space-md);
    margin: var(--space-2xl) 0 0;
    padding-top: var(--space-md);
    border-top: var(--border-hair) solid var(--c-rule);
  }

  .case__meta dt {
    margin-bottom: var(--space-3xs);
    color: var(--c-ink-muted);
    font-size: var(--text-3xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .case__meta dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .case__cover {
    margin-top: var(--space-2xl);
  }

  .case__cover :global(img) {
    width: 100%;
    border: var(--border-hair) solid var(--c-ink);
    border-radius: var(--radius-md);
    background-color: var(--c-paper);
  }

  .case__cover figcaption {
    margin-top: var(--space-2xs);
    color: var(--c-ink-muted);
    font-size: var(--text-2xs);
  }

  .case__layout {
    display: grid;
    grid-template-columns: var(--case-aside-width) minmax(0, var(--case-prose-width));
    justify-content: start;
    gap: clamp(var(--space-xl), 6vw, var(--space-4xl));
    align-items: start;
    margin-top: var(--space-2xl);
  }

  .case__aside {
    position: sticky;
    top: calc(var(--header-h) + var(--space-md));
    display: grid;
    gap: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: var(--border) solid var(--c-blue);
  }

  .case__outcome {
    display: grid;
    gap: var(--space-2xs);
  }

  .case__outcome-text {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  .case__aside-facts {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding-top: var(--space-sm);
    border-top: var(--border-hair) solid var(--c-rule);
  }

  .case__aside-facts dt {
    color: var(--c-ink-muted);
    font-size: var(--text-3xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .case__aside-facts dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .case__contact {
    justify-self: start;
    font-size: var(--text-2xs);
    padding: var(--space-2xs) var(--space-sm);
  }

  .case__prose {
    max-width: var(--case-prose-width);
  }

  .case__next {
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-3xl);
    padding: var(--space-lg);
    border: var(--border-hair) solid var(--c-ink);
    border-radius: var(--radius-md);
    background-color: var(--c-paper);
  }

  .case__next-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    text-decoration: none;
  }

  .case__next-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .case__next-link:hover .case__next-title {
    color: var(--c-blue);
  }

  .case__next-arrow {
    font-size: var(--text-xl);
    color: var(--c-blue);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .case__next-link:hover .case__next-arrow {
    transform: translateX(var(--space-2xs));
  }

  .case__next-meta {
    color: var(--c-ink-muted);
    font-size: var(--text-2xs);
  }

  @media (max-width: 56rem) {
    .case__layout {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .case__aside {
      position: static;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: var(--space-md);
    }

    .case__contact {
      grid-column: 1 / -1;
    }

    .case__prose {
      max-width: var(--measure);
    }
  }

  @media (max-width: 36rem) {
    .case__meta {
      grid-template-columns: 1fr 1fr;
    }

    .case__aside {
      grid-template-columns: 1fr;
    }

    .case__aside-facts {
      gap: var(--space-sm);
    }

    .case__next {
      padding: var(--space-md);
    }
  }
</style>
