---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../styles/tokens.css";
import "../styles/base.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import interUrl from "../assets/fonts/inter-normal.woff2?url";
import frauncesUrl from "../assets/fonts/fraunces-normal.woff2?url";
import frauncesItalicUrl from "../assets/fonts/fraunces-italic.woff2?url";

interface Props {
  title: string;
  description: string;
  ogImage: ImageMetadata;
  ogTitle?: string;
  ogType?: "website" | "article";
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogTitle = title,
  ogType = "website",
  bodyClass = "",
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://portfolio.example.com");
const pageTitle = `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, siteUrl);
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: "png" });
const ogUrl = new URL(og.src, siteUrl);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.role,
  url: new URL("/", siteUrl).href,
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Malang",
    addressCountry: "ID",
  },
  sameAs: [site.linkedin.href, site.github.href],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Matches --c-cream in tokens.css; browser chrome cannot read CSS variables. -->
    <meta name="theme-color" content="#f3eee1" />

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
